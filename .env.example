# Kopiere diese Datei nach .env und trage deine drei Schluessel ein.
# Die echte Datei wird von git ignoriert und landet nie auf GitHub.

# Apify - scrapt die Personen von LinkedIn
# Schluessel: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# BetterContact - Anreicherung Runde 1 (E-Mail + Mobilnummer)
# Schluessel: https://app.bettercontact.rocks/api_requests
BETTERCONTACT_API_KEY=

# Lusha - Anreicherung Runde 2 (zweite Quelle, findet was BetterContact nicht hat)
# Schluessel: Lusha Dashboard -> API
LUSHA_API_KEY=
